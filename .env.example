# Copy to .env for local development (npm run dev). On the host, set these in the dashboard.

PORT=3000
NODE_ENV=development

# Admin panel at /admin – pick a long, unique password.
ADMIN_PASSWORD=change-me
# Random string used to sign admin sessions (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Where the SQLite database lives. On Render/Railway/Fly, point this at the persistent disk.
DATA_DIR=./data

# Who gets notified about new bookings and contact messages.
NOTIFY_EMAIL=

# Optional SMTP for emails (e.g. Gmail app password, Brevo, Resend SMTP, Zoho).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
